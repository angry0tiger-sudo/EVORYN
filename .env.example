# Copy this file to .env. Empty optional values use safe code defaults.
# Setup scripts never overwrite an existing .env and never run live tests.

EVORYN_ENV=
EVORYN_LOG_LEVEL=
EVORYN_DATA_DIR=
EVORYN_DATABASE_URL=
EVORYN_METRICS_ENABLED=

# Read-only wallet query token only. Verify remote key permissions in Nobitex first.
NOBITEX_READONLY_API_TOKEN=
NOBITEX_BASE_URL=
NOBITEX_TIMEOUT_SECONDS=

# Hard source-code whitelist; unsupported quotes cannot be enabled through environment.
EVORYN_ALLOWED_QUOTE_CURRENCIES=USDT

# Global/legacy live switch remains off. Do not change to enable Spot writes.
ENABLE_REAL_TRADING=False

# Isolated Spot execution candidate: off by default and not a complete live runtime.
EVORYN_SPOT_ORDER_WRITES_ENABLED=False
EVORYN_LIVE_TRADING_ACK=
NOBITEX_SPOT_API_KEY=
NOBITEX_SPOT_PRIVATE_KEY=
EVORYN_EXECUTION_DB_PATH=./data/execution.sqlite3
EVORYN_MAX_MARKET_SLIPPAGE_BPS=50

# Reserved proxy placeholder. Currently ignored by EVORYN; transports force direct HTTPS.
# Proxy/SOCKS/VPN support requires a separately reviewed transport and explicit route approval.
EVORYN_PROXY_URL=
