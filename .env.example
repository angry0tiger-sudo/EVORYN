# Names only for secrets; values must be provided locally and never committed.
EVORYN_ENV=
EVORYN_LOG_LEVEL=
EVORYN_DATA_DIR=
EVORYN_DATABASE_URL=
EVORYN_METRICS_ENABLED=
# Configure only a provider-confirmed read-only token with no trade/withdraw permission.
NOBITEX_READONLY_API_TOKEN=
NOBITEX_BASE_URL=
NOBITEX_TIMEOUT_SECONDS=
EVORYN_ALLOWED_QUOTE_CURRENCIES=USDT
# Legacy global switch remains false. Do not use it to arm any live order path.
ENABLE_REAL_TRADING=False

# Gated local-only Spot execution candidate; keep disabled in GitHub and during development.
# The selected key must have READ + TRADE as required, and must NOT have withdrawal permission.
EVORYN_SPOT_ORDER_WRITES_ENABLED=False
EVORYN_LIVE_TRADING_ACK=
NOBITEX_SPOT_API_KEY=
NOBITEX_SPOT_PRIVATE_KEY=
EVORYN_EXECUTION_DB_PATH=./data/execution.sqlite3
EVORYN_MAX_MARKET_SLIPPAGE_BPS=50
